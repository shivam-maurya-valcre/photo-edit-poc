# Copy to .env and fill in. Never commit .env.

# Which service /poc/auto-fix uses when the request has no ?provider=: autoenhance or claid
AUTO_FIX_PROVIDER=autoenhance

# ===== Autoenhance =====
# From your Autoenhance account: Settings -> API keys
AUTOENHANCE_API_KEY=

# true = no credits used, result has a development watermark (start here)
AUTOENHANCE_DEV_MODE=true

# true = lower-quality preview; false = full-size image (uses a credit)
AUTOENHANCE_PREVIEW=true

# Optional: pin the AI model version so results don't change between runs
AUTOENHANCE_AI_VERSION=

# --- Photo options (see SAFE_SETTINGS in autoenhance.mjs) ---
# Straightening strength: PRESERVE_CONTENT keeps the whole property in frame (appraisal-safe).
# Others: DEFAULT_ENABLED, PRIORITIZE_PERSPECTIVE (straighter lines, heavy crop), OFF
AUTOENHANCE_PERSPECTIVE_MODE=PRESERVE_CONTENT
# true = blur faces and licence plates
AUTOENHANCE_PRIVACY=false

# --- Result download ---
# jpeg, png, webp, avif or jxl
AUTOENHANCE_FORMAT=jpeg
# 1-90
AUTOENHANCE_QUALITY=90
# Resize on Autoenhance's side to this width in px; empty = full size
AUTOENHANCE_MAX_WIDTH=

# --- Housekeeping ---
# Delete the photo from Autoenhance once we have the result (or it failed)
AUTOENHANCE_DELETE_AFTER_DOWNLOAD=true
# How often to check if processing is done, and when to give up
AUTOENHANCE_POLL_INTERVAL_MS=3000
AUTOENHANCE_TIMEOUT_SECONDS=300

# ===== Claid.ai (see CLAID_SETTINGS in claid.mjs) =====
# From the Claid dashboard: API keys
CLAID_API_KEY=
# Strength of Claid's automatic light and colour fix, 0-100 (0 = off; 100 is Claid's recommendation)
CLAID_HDR_INTENSITY=100
# Remove JPEG compression artifacts: off, auto (only when detected), moderate, strong
CLAID_DECOMPRESS=auto
# true = redraw parts of the image to look sharper (changes detail; off for appraisal photos)
CLAID_POLISH=false
# JPEG quality of the result, 1-100
CLAID_QUALITY=90
# Give up after this many seconds
CLAID_TIMEOUT_SECONDS=120

# ===== Server =====
PORT=3100
ALLOWED_ORIGIN=http://localhost:4200
ALLOWED_URL_HOSTS=static-photos.valcre.com,static-photos.dev.valcre.com,res.cloudinary.com
